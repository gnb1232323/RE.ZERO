# Copy this file to ".env" next to docker-compose.yml and fill in real values.
# Never commit the real .env file.

# Domain that points at this server (needed for automatic HTTPS via Caddy)
DOMAIN=crm.example.com

# Which app image to run. Leave unset to build locally from source (needs ~1GB+ RAM
# free during the build). On a low-RAM server, point this at the image built by
# .github/workflows/docker-publish.yml instead, and use `docker compose pull app`
# rather than `--build`:
# APP_IMAGE=ghcr.io/<github-username>/re-zero-crm:latest

# Postgres
POSTGRES_USER=rezero
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=re_zero_crm

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Accounts created once by the seed script. User 1 and 2 get the OWNER role
# (full access); user 3 gets SALES; user 4 gets MARKETING. Change passwords
# after first login via the in-app "Настройки" page.
SEED_USER_1_EMAIL=owner@example.com
SEED_USER_1_NAME=Owner
SEED_USER_1_PASSWORD=change-me
SEED_USER_2_EMAIL=partner@example.com
SEED_USER_2_NAME=Partner
SEED_USER_2_PASSWORD=change-me
SEED_USER_3_EMAIL=rop@example.com
SEED_USER_3_NAME=РОП
SEED_USER_3_PASSWORD=change-me
SEED_USER_4_EMAIL=rom@example.com
SEED_USER_4_NAME=РОМ
SEED_USER_4_PASSWORD=change-me

# Google Drive receipt uploads — OAuth client + refresh token for the Google
# account that owns the two Drive folders (students folder, receipts folder).
# See docker/DEPLOY.md for how these were generated.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_STUDENTS_FOLDER_ID=
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=

# Marketing site origin allowed to call POST /api/public/leads (CORS)
PUBLIC_SITE_ORIGIN=https://rezero.example.com

# Telegram notification for new website leads — bot token from @BotFather,
# and comma-separated chat IDs of people who should get the message
# (message the bot once, then read the chat id from the Bot API's getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Optional: forum topic (message_thread_id) to post into, e.g. a "Работа с клиентами" topic
TELEGRAM_TOPIC_ID=
