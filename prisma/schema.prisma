// Prisma schema for RE ZERO CRM
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PipelineStage {
  LEAD
  TRIAL_BOOKED
  TRIAL_DONE
  PAID_ENROLLED
  STUDYING
  COMPLETED
  RENEWED_REFERRAL
  LOST
}

enum LessonFormat {
  INDIVIDUAL
  GROUP
}

enum LeadSource {
  INSTAGRAM
  WHATSAPP
  TELEGRAM
  REFERRAL
  ADS
  WEBSITE
  OTHER
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  TASK_CREATED
  TASK_COMPLETED
  SYSTEM
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum UserRole {
  OWNER
  SALES
  MARKETING
  TEACHER
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(OWNER)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedContacts    Contact[]       @relation("ContactOwner")
  taughtContacts   Contact[]       @relation("ContactTeacher")
  activities       Activity[]
  tasksAssigned    Task[]          @relation("TaskAssignee")
  tasksCreated     Task[]          @relation("TaskCreator")
  receipts         Receipt[]
  intakesAuthored  IntakeProfile[]
  lessonsTaught    LessonSlot[]    @relation("LessonTeacher")
}

model Contact {
  id               String        @id @default(cuid())
  fullName         String
  phone            String
  email            String?
  age              Int?
  instagram        String?
  whatsapp         String?
  telegram         String?
  source           LeadSource    @default(OTHER)
  sourceDetail     String?
  format           LessonFormat?
  stage            PipelineStage @default(LEAD)
  ownerId          String?
  owner            User?         @relation("ContactOwner", fields: [ownerId], references: [id])
  teacherId        String?
  teacher          User?         @relation("ContactTeacher", fields: [teacherId], references: [id])
  referredById     String?
  referredBy       Contact?      @relation("ContactReferral", fields: [referredById], references: [id])
  referrals        Contact[]     @relation("ContactReferral")
  lastContactedAt  DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  activities    Activity[]
  tasks         Task[]
  student       Student?
  intake        IntakeProfile?
  notifications Notification[]

  @@index([stage])
  @@index([source])
  @@index([ownerId])
  @@index([teacherId])
}

model IntakeProfile {
  id          String   @id @default(cuid())
  contactId   String   @unique
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  interests   String?
  occupation  String?
  goal        String?
  painPoint   String?
  fears       String?
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id        String       @id @default(cuid())
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  type      ActivityType
  body      String
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([contactId, createdAt])
}

model Task {
  id           String     @id @default(cuid())
  contactId    String
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title        String
  dueAt        DateTime
  status       TaskStatus @default(OPEN)
  assignedToId String?
  assignedTo   User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?      @relation("TaskCreator", fields: [createdById], references: [id])
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([dueAt, status])
  @@index([contactId])
}

model Student {
  id             String        @id @default(cuid())
  contactId      String        @unique
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  code           String        @unique
  courseStartDate DateTime
  targetLevel    String?
  targetDate     DateTime?
  currentLevel   String?
  progressNotes  String?
  paymentAmount  Decimal       @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentNotes   String?
  pricePerLesson Decimal?      @db.Decimal(10, 2)
  lessonBalance  Decimal       @default(0) @db.Decimal(10, 2)
  driveFolderId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  receipts Receipt[]
  lessons  LessonSlot[]
}

model LessonSlot {
  id               String       @id @default(cuid())
  studentId        String
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId        String?
  teacher          User?        @relation("LessonTeacher", fields: [teacherId], references: [id])
  scheduledAt      DateTime
  status           LessonStatus @default(SCHEDULED)
  wasLate          Boolean      @default(false)
  lessonRating     Int?
  engagementRating Int?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([studentId, scheduledAt])
  @@index([teacherId, scheduledAt])
}

model Notification {
  id        String   @id @default(cuid())
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@index([contactId])
}

model Receipt {
  id            String        @id @default(cuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileName      String
  driveFileId   String
  driveViewLink String
  paymentAmount Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus
  uploadedById  String
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([studentId])
}
